# --- Claude (pick one) -------------------------------------------------------
ANTHROPIC_API_KEY=
# or a Claude subscription token from `claude setup-token`:
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Trello: key at https://trello.com/power-ups/admin (API key), then generate a token
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=6b02f70d3864e3b04fd25e63

# --- GitHub: a fine-grained token covering every repository in REPO_LABELS, with
#     Contents: read/write, Pull requests: read/write, Workflows: read/write,
#     Checks: read, Metadata: read
#     Actions: read (optional: without it lights-out only sees check summaries, not full CI logs)
GITHUB_TOKEN=
# Which repository a card is about is set by its Trello label: label=owner/repo, comma-separated.
# A card must carry exactly one of these labels (`lights-out setup-board` creates them on the board).
REPO_LABELS=my-app=your-org/my-app
# Optional: repository for cards with no repository label (empty = ask for a label).
DEFAULT_REPO=
BASE_BRANCH=main

# Optional: Trello usernames (without the @, comma-separated, case-insensitive) whose queued cards
# are processed. Comments from other members are hidden from the agents. Empty = anyone with board
# access can queue work, which is risky because the agent has merge rights.
ALLOWED_MEMBERS=

# --- Trello columns -----------------------------------------------------------
# The agent takes cards from LIST_READY (top first); set a stage list to empty to skip it.
LIST_READY=Queued
LIST_TRIAGED=Triaged
LIST_IN_PROGRESS=In Progress
LIST_VERIFYING=Verifying
LIST_REVIEWING=Reviewing
LIST_PR_OPENED=PR Opened
LIST_NEEDS_INFO=Needs Info
LIST_FAILED=Failed
LIST_DONE=Done

# --- Models ---------------------------------------------------------------------
PLANNER_MODEL=claude-opus-5-5
CODER_MODEL=claude-sonnet-5-5
REVIEWER_MODEL=claude-opus-5-5
# Effort per role: low, medium, high, xhigh, max, or empty for the model's default.
PLANNER_EFFORT=high
CODER_EFFORT=
REVIEWER_EFFORT=high

# --- Limits ---------------------------------------------------------------------
MAX_TICKET_USD=10
MAX_DAY_USD=50
MAX_FIX_ATTEMPTS=3
# Times a failed CI run is sent back to the coder to fix (0 = do not retry, leave the PR open)
MAX_CI_FIX_ATTEMPTS=2
MAX_REVIEW_ROUNDS=2
CHECK_COMMAND=make check
MERGE_WITHOUT_CI=false
# Merge policy: a change that touches one of these paths (comma-separated globs, anchored at the repo
# root; `**` spans directories) or changes more than MAX_AUTO_MERGE_LINES lines (added + deleted) is left
# open for a human instead of being merged. An EMPTY HUMAN_REVIEW_PATHS disables path holds; 0 disables
# the size limit. Left commented out so the defaults apply.
# HUMAN_REVIEW_PATHS=.github/**,Dockerfile*,docker/**,Makefile,pyproject.toml,requirements*.txt,setup.py,setup.cfg,package.json,package-lock.json,yarn.lock,pnpm-lock.yaml,go.mod,go.sum,Cargo.toml,Cargo.lock,**/migrations/**,**/auth/**,**/*auth*.py
# MAX_AUTO_MERGE_LINES=400

# --- Queue watching -----------------------------------------------------------
# Seconds between checks of the Queued column (a card is picked up within this time).
POLL_SECONDS=15
# Seconds without a sign of life before /healthz reports stale (503).
HEALTH_STALE_S=900
# Seconds between checks of PRs left open for a human (a `/lights-out merge` comment, or merged/closed by hand).
PR_POLL_SECONDS=120
# Container time zone (used for the daily budget and report dates).
TZ=UTC

# --- Commit author (defaults to lights-out). Use your GitHub no-reply address
#     (<id>+<login>@users.noreply.github.com) to have commits attributed to you.
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
