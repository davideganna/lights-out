+
+
+def test_import_csv(data, tmp_path, capsys):
+    csv_file = tmp_path / "in.csv"
+    csv_file.write_text("category,date,amount\nfood,2024-03-05,12.50\n")
+    assert main(["--file", data, "import", str(csv_file)]) == 0
+    assert capsys.readouterr().out.splitlines() == ["Imported 1 expenses"]
+    main(["--file", data, "list"])
+    assert capsys.readouterr().out.splitlines() == ["2024-03-05  12.50  food"]
+
+
+def test_import_with_a_bad_row_imports_nothing(data, tmp_path, capsys):
+    csv_file = tmp_path / "in.csv"
+    csv_file.write_text("date,amount,category\n2024-03-05,12.50,food\n2024-03-06,x,food\n")
+    assert main(["--file", data, "import", str(csv_file)]) == 1
+    assert "line 3" in capsys.readouterr().err
+    main(["--file", data, "list"])
+    assert capsys.readouterr().out == ""
