+def _read_csv(path: str) -> list[Expense]:
+    """All rows of a CSV file with a header, or a ValueError naming the first bad line (the header is line 1)."""
+    expenses = []
+    with open(path, newline="", encoding="utf-8") as f:
+        reader = csv.DictReader(f)
+        missing = {"date", "amount", "category"} - set(reader.fieldnames or [])
+        if missing:
+            raise ValueError(f"line 1: missing column(s) {', '.join(sorted(missing))}")
+        for row in reader:
+            values = {key: (row.get(key) or "").strip() for key in ("date", "amount", "category", "note")}
+            try:
+                if not values["category"]:
+                    raise argparse.ArgumentTypeError("missing category")
+                expenses.append(
+                    Expense(_date(values["date"]), _amount(values["amount"]), values["category"], values["note"])
+                )
+            except argparse.ArgumentTypeError as e:
+                raise ValueError(f"line {reader.line_num}: {e}") from None
+    return expenses
+
