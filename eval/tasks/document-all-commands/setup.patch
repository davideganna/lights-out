+
+
+def test_categories_are_listed_once_and_sorted(data, capsys):
+    main(["--file", data, "add", "2024-03-05", "10", "transport"])
+    main(["--file", data, "add", "2024-03-06", "5", "food"])
+    main(["--file", data, "add", "2024-03-07", "1", "food"])
+    capsys.readouterr()
+    assert main(["--file", data, "categories"]) == 0
+    assert capsys.readouterr().out.splitlines() == ["food", "transport"]
