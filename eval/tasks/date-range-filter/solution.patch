+
+
+def test_list_and_report_accept_a_date_range(data, capsys):
+    main(["--file", data, "add", "2024-03-05", "10", "food"])
+    main(["--file", data, "add", "2024-03-06", "5", "food"])
+    main(["--file", data, "add", "2024-03-07", "1", "food"])
+    capsys.readouterr()
+    main(["--file", data, "list", "--from", "2024-03-06", "--to", "2024-03-06"])
+    assert capsys.readouterr().out.splitlines() == ["2024-03-06  5  food"]
+    main(["--file", data, "report", "--from", "2024-03-06"])
+    assert capsys.readouterr().out.splitlines() == ["food  6"]
