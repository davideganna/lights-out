diff --git a/tests/test_cli.py b/tests/test_cli.py
index c92871b..a1e2c54 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -40,3 +40,14 @@ def test_add_rejects_bad_input(data, bad):
