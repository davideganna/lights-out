diff --git a/tests/test_cli.py b/tests/test_cli.py
index c92871b..789c819 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -40,3 +40,25 @@ def test_add_rejects_bad_input(data, bad):
     with pytest.raises(SystemExit) as exc:
         main(["--file", data, "add", *bad])
     assert exc.value.code == 2
+
+
+def test_edit_changes_only_the_given_fields(data, capsys):
+    main(["--file", data, "add", "2024-03-05", "12.50", "food", "--note", "lunch"])
+    capsys.readouterr()
+    assert main(["--file", data, "edit", "1", "--amount", "13"]) == 0
+    assert capsys.readouterr().out.splitlines() == ["Updated 2024-03-05  13  food  lunch"]
+    assert main(["--file", data, "edit", "1", "--category", "dining"]) == 0
+    assert capsys.readouterr().out.splitlines() == ["Updated 2024-03-05  13  dining  lunch"]
+
+
+@pytest.mark.parametrize("args", [["1"], ["2", "--amount", "1"], ["1", "--amount", "-1"]])
+def test_edit_rejects_bad_input(data, capsys, args):
+    main(["--file", data, "add", "2024-03-05", "12.50", "food"])
+    try:
+        code = main(["--file", data, "edit", *args])
+    except SystemExit as e:
+        code = e.code
+    assert code != 0
+    capsys.readouterr()
+    main(["--file", data, "list"])
+    assert capsys.readouterr().out.splitlines() == ["2024-03-05  12.50  food"]
