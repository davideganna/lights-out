diff --git a/src/ledger/storage.py b/src/ledger/storage.py
index 1219a49..3dcb1f0 100644
--- a/src/ledger/storage.py
+++ b/src/ledger/storage.py
@@ -1,9 +1,10 @@
-"""Keep expenses in a JSON file."""
+"""Keep expenses in a JSON file, or in memory."""
 
 from __future__ import annotations
 
 import json
 from pathlib import Path
+from typing import Protocol
 
 from .models import Expense
 
@@ -19,3 +20,35 @@ def load(path: str | Path) -> list[Expense]:
 def save(path: str | Path, expenses: list[Expense]) -> None:
     data = [e.to_dict() for e in expenses]
     Path(path).write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
+
+
+class Store(Protocol):
+    def load(self) -> list[Expense]: ...
+
+    def save(self, expenses: list[Expense]) -> None: ...
+
+
+class JsonFileStore:
+    """Expenses kept in a JSON file."""
+
+    def __init__(self, path: str | Path) -> None:
+        self.path = Path(path)
+
+    def load(self) -> list[Expense]:
+        return load(self.path)
+
+    def save(self, expenses: list[Expense]) -> None:
+        save(self.path, expenses)
+
+
+class MemoryStore:
+    """Expenses kept in memory only, for tests."""
+
+    def __init__(self, expenses: list[Expense] | None = None) -> None:
+        self._expenses = list(expenses or [])
+
+    def load(self) -> list[Expense]:
+        return list(self._expenses)
+
+    def save(self, expenses: list[Expense]) -> None:
+        self._expenses = list(expenses)
diff --git a/tests/test_cli.py b/tests/test_cli.py
index c92871b..23b298d 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -40,3 +40,14 @@ def test_add_rejects_bad_input(data, bad):
     with pytest.raises(SystemExit) as exc:
         main(["--file", data, "add", *bad])
     assert exc.value.code == 2
+
+
+def test_main_uses_the_given_store_instead_of_a_file(data, capsys):
+    from ledger.storage import MemoryStore
+
+    store = MemoryStore()
+    assert main(["--file", data, "add", "2024-03-05", "12.50", "food"], store=store) == 0
+    assert len(store.load()) == 1
+    capsys.readouterr()
+    assert main(["list"], store=store) == 0
+    assert capsys.readouterr().out.splitlines() == ["2024-03-05  12.50  food"]
