+def test_memory_store_round_trip():
+    items = [Expense(datetime.date(2024, 3, 5), Decimal("12.50"), "food", "lunch")]
+    store = storage.MemoryStore()
+    assert store.load() == []
+    store.save(items)
+    assert store.load() == items
+
+
+def test_json_file_store_round_trip(tmp_path):
+    store = storage.JsonFileStore(tmp_path / "l.json")
+    items = [Expense(datetime.date(2024, 3, 5), Decimal("12.50"), "food", "lunch")]
+    store.save(items)
+    assert store.load() == items
