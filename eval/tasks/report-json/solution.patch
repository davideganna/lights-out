+
+
+def test_report_json(data, capsys):
+    import json
+
+    main(["--file", data, "add", "2024-03-05", "10.50", "food"])
+    main(["--file", data, "add", "2024-03-06", "5", "food"])
+    capsys.readouterr()
+    main(["--file", data, "report", "--json"])
+    assert json.loads(capsys.readouterr().out) == {"food": "15.50"}
+    main(["--file", data, "report", "--by", "month", "--json"])
+    assert json.loads(capsys.readouterr().out) == {"2024-03": "15.50"}
