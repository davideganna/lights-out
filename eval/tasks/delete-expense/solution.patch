diff --git a/tests/test_cli.py b/tests/test_cli.py
index c92871b..0e772fe 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -40,3 +40,26 @@ def test_add_rejects_bad_input(data, bad):
     with pytest.raises(SystemExit) as exc:
         main(["--file", data, "add", *bad])
     assert exc.value.code == 2
+
+
+def test_delete_removes_the_numbered_expense(data, capsys):
+    main(["--file", data, "add", "2024-03-05", "12.50", "food"])
+    main(["--file", data, "add", "2024-03-06", "3", "transport"])
+    capsys.readouterr()
+    assert main(["--file", data, "delete", "2"]) == 0
+    assert capsys.readouterr().out.splitlines() == ["Deleted 2024-03-06  3  transport"]
+    main(["--file", data, "list"])
+    assert capsys.readouterr().out.splitlines() == ["2024-03-05  12.50  food"]
+
+
+@pytest.mark.parametrize("bad", ["0", "2", "x"])
+def test_delete_rejects_bad_numbers(data, capsys, bad):
+    main(["--file", data, "add", "2024-03-05", "12.50", "food"])
+    try:
+        code = main(["--file", data, "delete", bad])
+    except SystemExit as e:
+        code = e.code
+    assert code != 0
+    capsys.readouterr()
+    main(["--file", data, "list"])
+    assert capsys.readouterr().out.splitlines() == ["2024-03-05  12.50  food"]
